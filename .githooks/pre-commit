#!/bin/sh
# Pre-commit hook to prevent commits to local_settings.py
# This file should be copied to .git/hooks/pre-commit or linked

# Check if local_settings.py is being committed
if git diff --cached --name-only | grep -q "afina/local_settings.py"; then
    echo "❌ ERROR: Cannot commit changes to afina/local_settings.py"
    echo "This file is protected and should not be modified in the repository."
    echo "If you need to change database settings, modify your local copy only."
    exit 1
fi

exit 0

