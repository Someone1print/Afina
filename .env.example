# Скопируйте в .env и заполните своими значениями (файл .env в .gitignore).
# Django
DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# База данных (PostgreSQL)
